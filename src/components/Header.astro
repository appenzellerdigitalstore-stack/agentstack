---
/**
 * Site header with nav and category links.
 */
import { getTotalListingsCount } from '../lib/listings';
import Clock from './Clock.astro';

const currentPath = Astro.url.pathname;
const totalCount = getTotalListingsCount();

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/sponsor', label: 'Sponsor' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 border-b border-ink-800/80 bg-ink-950/80 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="h-8 w-8 rounded-lg bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-ink-950 font-bold text-lg shadow-lg shadow-brand-500/20 group-hover:shadow-brand-500/40 transition-shadow">
        A
      </div>
      <div class="flex flex-col leading-none">
        <span class="text-base font-semibold text-ink-50">AgentStack</span>
        <span class="text-[10px] text-ink-500 font-mono uppercase tracking-wider">{totalCount} tools</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'px-3 py-1.5 text-sm rounded-md transition-colors',
            currentPath === link.href
              ? 'text-ink-50 bg-ink-800/60'
              : 'text-ink-300 hover:text-ink-50 hover:bg-ink-800/40',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:block">
      <Clock />
    </div>

    <div class="flex items-center gap-2">
      <a
        href="https://github.com/appenzellerdigitalstore-stack/agentstack"
        target="_blank"
        rel="noopener"
        class="btn btn-ghost hidden sm:inline-flex"
        aria-label="GitHub"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.79-.26.79-.58v-2.17c-3.34.73-4.04-1.42-4.04-1.42-.55-1.38-1.33-1.75-1.33-1.75-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.62-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.31-.54-1.54.11-3.2 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3-.4c1.02 0 2.04.13 3 .4 2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.89.12 3.2.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.93.43.37.81 1.1.81 2.22v3.29c0 .32.19.7.8.58C20.57 21.79 24 17.3 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
      <a href="/sponsor" class="btn btn-primary hidden sm:inline-flex">
        Get listed
      </a>
      <button
        id="mobile-menu-button"
        class="md:hidden btn btn-ghost p-2"
        aria-label="Menu"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-ink-800/80">
    <nav class="container-page py-3 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'px-3 py-2 text-sm rounded-md transition-colors',
            currentPath === link.href
              ? 'text-ink-50 bg-ink-800/60'
              : 'text-ink-300 hover:text-ink-50 hover:bg-ink-800/40',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
