---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Support This Project"
  description="AgentStack is free, ad-supported, and community-run. If you find it useful, you can support it via PayPal."
>
  <div class="container-page max-w-2xl py-16">
    <h1 class="text-4xl font-bold mb-4">Support this project</h1>
    <p class="text-lg text-ink-300 leading-relaxed mb-8">
      AgentStack is a free directory. There are no paid tiers, no premium features, no subscriptions. The site is paid for by Google AdSense (ads on some pages) and by donations from people who find it useful.
    </p>

    <div class="card p-6 mb-8">
      <h2 class="text-lg font-semibold mb-3">If you want to support</h2>
      <p class="text-sm text-ink-400 mb-4">
        A small donation via PayPal helps cover the domain renewal and the time spent curating listings. It does not give you anything in return — this site will work the same whether you donate or not.
      </p>
      <a
        href="https://paypal.me/edyappenzeller"
        target="_blank"
        rel="noopener"
        class="btn btn-primary"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81 1.01 1.15 1.304 2.42 1.012 4.287-.023.143-.047.288-.077.437-.983 5.05-4.349 6.797-8.647 6.797h-2.19c-.524 0-.968.382-1.05.9l-1.12 7.106zm14.146-7.42c-.115-.742-.527-1.357-1.148-1.737-.604-.37-1.395-.555-2.348-.555h-3.846c-.467 0-.866.317-.943.77l-.668 4.232-.467 2.96-.283 1.79a.642.642 0 0 0 .633.74h2.34c.43 0 .797-.31.857-.733l.017-.092.687-4.353.045-.246c.077-.42.43-.733.857-.733h.539c3.51 0 6.262-1.43 7.067-5.557.4-2.04.193-3.74-1.013-4.96z"/>
        </svg>
        Donate via PayPal
      </a>
    </div>

    <div class="card p-6 mb-8">
      <h2 class="text-lg font-semibold mb-3">Other ways to support</h2>
      <ul class="text-sm text-ink-300 space-y-2">
        <li class="flex gap-2"><span class="text-brand-400">→</span><span>Submit a tool you love via the <a href="/contact" class="text-brand-400 hover:text-brand-300">contact form</a></span></li>
        <li class="flex gap-2"><span class="text-brand-400">→</span><span>Share AgentStack on Twitter, Reddit, or Hacker News</span></li>
        <li class="flex gap-2"><span class="text-brand-400">→</span><span>Link to a listing from your blog or docs</span></li>
        <li class="flex gap-2"><span class="text-brand-400">→</span><span>Tell a friend who builds AI agents</span></li>
      </ul>
    </div>

    <div class="text-sm text-ink-500">
      <p>
        The site is built and maintained as a side project. No team, no office, no investors. Just one person who uses these tools daily and wanted a cleaner way to find them.
      </p>
    </div>
  </div>
</Layout>
