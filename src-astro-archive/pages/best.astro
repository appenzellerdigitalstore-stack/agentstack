---
/**
 * /best — single-page curated view. Designed to be screenshot-shared.
 * Loads the top 15 listings by hand-picking slugs. Update the slug list below
 * as the curated set changes.
 */
import Layout from '../layouts/Layout.astro';
import {
  getListingBySlug,
  getCategoryBySlug,
  getPublisherBySlug,
  getTotalListingsCount,
  type Listing,
} from '../lib/listings';

const CURATED_SLUGS = [
  'github-mcp',
  'filesystem-mcp',
  'memory-mcp',
  'fetch-mcp',
  'brave-search-mcp',
  'puppeteer-mcp',
  'firecrawl-mcp',
  'cloudflare-mcp',
  'notion-mcp',
  'supabase-mcp',
  'linear-mcp',
  'slack-mcp',
  'sentry-mcp',
  'tavily-mcp',
  'meilisearch-mcp',
];

const listings: Listing[] = CURATED_SLUGS
  .map((s) => getListingBySlug(s))
  .filter((l): l is Listing => Boolean(l));

const totalCount = getTotalListingsCount();
---

<Layout
  title="The 15 Best MCP Servers for AI Agents (2026)"
  description="A hand-curated, ranked list of the 15 most useful MCP servers and AI agent tools. Updated for 2026."
>
  <div class="container-page max-w-3xl py-12">
    <header class="mb-10 text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-brand-500/10 ring-1 ring-inset ring-brand-500/20 px-3 py-1 text-xs font-medium text-brand-300 mb-4">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-400 animate-pulse"></span>
        Updated {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight leading-[1.05]">
        The 15 best <span class="text-brand-400">MCP servers</span><br />for AI agents
      </h1>
      <p class="mt-4 text-lg text-ink-300 max-w-2xl mx-auto leading-relaxed">
        Hand-curated, tested, and ranked. Every tool on this list is one we'd actually use in production. {listings.length} of {totalCount} total.
      </p>
      <p class="mt-3 text-sm text-ink-500">
        Updated regularly · <a href="/listings" class="text-brand-400 hover:text-brand-300">see all {totalCount} →</a>
      </p>
    </header>

    <ol class="space-y-4">
      {listings.map((listing, i) => {
        const category = getCategoryBySlug(listing.category);
        const publisher = getPublisherBySlug(listing.publisher);
        const rank = i + 1;
        return (
          <li class="card p-5">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-ink-950 font-bold text-sm">
                {rank}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-3 mb-2">
                  <div class="min-w-0 flex-1">
                    <h2 class="text-lg font-semibold text-ink-50">
                      <a
                        href={`/listings/${listing.slug}`}
                        class="hover:text-brand-300 transition-colors"
                      >
                        {listing.name}
                      </a>
                    </h2>
                    {publisher && (
                      <p class="text-xs text-ink-500 mt-0.5">by {publisher.name}</p>
                    )}
                  </div>
                  <div class="flex flex-col items-end gap-1 flex-shrink-0">
                    {listing.trust.isOfficial && (
                      <span class="badge badge-official">Official</span>
                    )}
                    <span class:list={[
                      'badge capitalize',
                      listing.pricing === 'free' ? 'badge-free' : listing.pricing === 'freemium' ? 'badge-freemium' : 'badge-paid',
                    ]}>
                      {listing.pricing}
                    </span>
                  </div>
                </div>

                <p class="text-sm text-ink-300 leading-relaxed mb-3">
                  {listing.shortDescription}
                </p>

                <div class="flex flex-wrap items-center gap-2">
                  {category && (
                    <span class="badge text-ink-400 ring-1 ring-inset ring-ink-700" style="background: rgba(0,0,0,0.3)">
                      {category.name}
                    </span>
                  )}
                  {listing.tags.slice(0, 3).map((t) => (
                    <span class="badge text-ink-400 ring-1 ring-inset ring-ink-700" style="background: rgba(0,0,0,0.3)">
                      #{t}
                    </span>
                  ))}
                </div>

                <div class="flex items-center gap-3 mt-4">
                  <a
                    href={`/listings/${listing.slug}`}
                    class="text-xs text-brand-400 hover:text-brand-300 font-medium"
                  >
                    Full review →
                  </a>
                  <span class="text-ink-700">·</span>
                  <a
                    href={listing.externalUrl}
                    target="_blank"
                    rel="noopener"
                    class="text-xs text-ink-400 hover:text-ink-200"
                  >
                    Visit site ↗
                  </a>
                </div>
              </div>
            </div>
          </li>
        );
      })}
    </ol>

    <div class="mt-12 text-center">
      <p class="text-sm text-ink-400 mb-3">
        See the full directory with all {totalCount} tools, plus categories, search, and install commands.
      </p>
      <a href="/" class="btn btn-primary">View all {totalCount} tools</a>
    </div>
  </div>
</Layout>
