---
/**
 * Base layout for all pages. Provides:
 * - SEO meta tags
 * - Header + Footer
 * - Global styles
 * - AdSense auto-ads (when approved)
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOMeta from '../components/SEOMeta.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  hideHeader?: boolean;
}

const { title, description, canonical, ogImage, ogType, noindex, hideHeader } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#020617" />

    <SEOMeta
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />

    <!-- Cloudflare Web Analytics (free, no cookie banner) -->
    <!-- Enable after Cloudflare Pages deploy: insert the beacon script here -->

    <!-- AdSense auto-ads. Pub-ID is account-level (works for all your sites). -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8749554989768993"
         crossorigin="anonymous"></script>
  </head>
  <body>
    {!hideHeader && <Header />}
    <main id="main" class="min-h-[60vh]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
