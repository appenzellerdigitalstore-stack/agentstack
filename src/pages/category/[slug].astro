---
/**
 * Category page. Lists all tools in a category.
 */
import Layout from '../../layouts/Layout.astro';
import ListingCard from '../../components/ListingCard.astro';
import {
  getAllCategories,
  getAllCategorySlugs,
  getCategoryBySlug,
  getListingsByCategory,
} from '../../lib/listings';

export async function getStaticPaths() {
  return getAllCategorySlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const category = getCategoryBySlug(slug!);
const listings = category ? getListingsByCategory(slug!) : [];

if (!category) {
  return Astro.redirect('/404');
}

const allCategories = getAllCategories();
---

<Layout
  title={`${category.name} — AI Agent Tools Directory`}
  description={category.description}
>
  <div class="container-page py-12">
    <nav class="text-xs text-ink-500 mb-6 font-mono">
      <a href="/" class="hover:text-ink-300">Home</a>
      <span class="mx-2">/</span>
      <span class="text-ink-300">{category.name}</span>
    </nav>

    <header class="mb-10 max-w-3xl">
      <h1 class="text-4xl font-bold tracking-tight">{category.name}</h1>
      <p class="mt-3 text-lg text-ink-300 leading-relaxed">{category.description}</p>
      <p class="mt-4 text-sm text-ink-500 font-mono">{listings.length} tool{listings.length === 1 ? '' : 's'} in this category</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {listings.map((l) => <ListingCard listing={l} />)}
    </div>

    {listings.length === 0 && (
      <div class="card p-8 text-center">
        <p class="text-ink-400">No tools in this category yet. Check back soon.</p>
      </div>
    )}

    <!-- Other categories -->
    <section class="mt-16 pt-12 border-t border-ink-800/60">
      <h2 class="text-sm font-semibold text-ink-200 mb-4">Other categories</h2>
      <div class="flex flex-wrap gap-2">
        {allCategories.filter((c) => c.slug !== category.slug).map((c) => (
          <a
            href={`/category/${c.slug}`}
            class="badge text-ink-300 ring-1 ring-inset ring-ink-700 hover:text-brand-300 hover:ring-brand-500/40 transition-colors"
            style="background: rgba(0,0,0,0.3)"
          >
            {c.name}
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
