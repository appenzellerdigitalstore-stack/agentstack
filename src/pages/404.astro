---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Page Not Found"
  description="The page you were looking for doesn't exist on AgentStack."
  noindex
>
  <div class="container-page max-w-xl py-24 text-center">
    <div class="text-7xl font-bold text-ink-700 mb-4 font-mono">404</div>
    <h1 class="text-3xl font-semibold mb-3">We couldn't find that page.</h1>
    <p class="text-ink-400 mb-8">The tool or page you were looking for might have been moved, renamed, or doesn't exist yet.</p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="btn btn-primary">Back to homepage</a>
      <a href="/contact" class="btn btn-secondary">Report a broken link</a>
    </div>
  </div>
</Layout>
