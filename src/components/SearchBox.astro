---
/**
 * Client-side fuzzy search using Fuse.js. Loads all listings as JSON,
 * searches them in-browser, renders matching cards. Zero backend.
 */
---

<div class="search-box w-full">
  <div class="relative">
    <svg
      class="absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-ink-500 pointer-events-none"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
    <input
      id="search-input"
      type="search"
      placeholder="Search MCP servers, skills, integrations… (e.g. 'postgres', 'web scraping', 'github')"
      class="w-full rounded-xl bg-ink-900/80 ring-1 ring-inset ring-ink-800 focus:ring-brand-500 pl-12 pr-4 py-4 text-base text-ink-100 placeholder:text-ink-500 outline-none transition-shadow"
      autocomplete="off"
      spellcheck="false"
    />
  </div>
  <p id="search-status" class="mt-2 text-xs text-ink-500 font-mono"></p>
</div>

<div id="search-results" class="mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>

<!-- Template for a search result card -->
<template id="search-result-template">
  <a href="" class="card card-hover p-5 block group">
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-3 min-w-0">
        <div class="result-avatar h-10 w-10 rounded-lg bg-gradient-to-br from-ink-700 to-ink-800 ring-1 ring-ink-700 flex items-center justify-center text-ink-100 font-bold text-sm flex-shrink-0"></div>
        <div class="min-w-0">
          <h3 class="result-name font-semibold text-ink-50 truncate group-hover:text-brand-300 transition-colors"></h3>
          <p class="result-publisher text-xs text-ink-500 truncate"></p>
        </div>
      </div>
      <span class="result-pricing badge flex-shrink-0 capitalize"></span>
    </div>
    <p class="result-desc text-sm text-ink-300 leading-relaxed line-clamp-3 mb-4"></p>
    <div class="flex items-center justify-between gap-2 text-xs">
      <span class="result-category badge text-ink-400 ring-1 ring-inset ring-ink-700" style="background: rgba(0,0,0,0.3)"></span>
      <div class="flex items-center gap-1.5 text-ink-500">
        <span class="result-status-dot inline-block h-1.5 w-1.5 rounded-full"></span>
        <span class="result-latency font-mono"></span>
      </div>
    </div>
  </a>
</template>

<script>
  import Fuse from 'fuse.js';

  let allListings: any[] = [];
  let fuse: Fuse<any> | null = null;

  async function loadListings() {
    try {
      const res = await fetch('/api/listings.json');
      allListings = await res.json();
      fuse = new Fuse(allListings, {
        keys: [
          { name: 'name', weight: 0.4 },
          { name: 'tagline', weight: 0.25 },
          { name: 'shortDescription', weight: 0.15 },
          { name: 'tags', weight: 0.1 },
          { name: 'useCases', weight: 0.05 },
          { name: 'category', weight: 0.05 },
        ],
        threshold: 0.35,
        includeScore: true,
        minMatchCharLength: 2,
      });
    } catch (err) {
      console.error('Failed to load listings', err);
    }
  }

  function renderResult(listing: any) {
    const template = document.getElementById('search-result-template') as HTMLTemplateElement;
    const node = template.content.cloneNode(true) as DocumentFragment;
    const a = node.querySelector('a')!;
    a.href = `/listings/${listing.slug}`;
    node.querySelector('.result-avatar')!.textContent = listing.name.charAt(0);
    node.querySelector('.result-name')!.textContent = listing.name;
    node.querySelector('.result-publisher')!.textContent = listing.publisher ? `by ${listing.publisher}` : '';
    const desc = node.querySelector('.result-desc')!;
    desc.textContent = listing.shortDescription;
    const pricing = node.querySelector('.result-pricing')!;
    pricing.textContent = listing.pricing;
    pricing.classList.add(listing.pricing === 'free' ? 'badge-free' : listing.pricing === 'freemium' ? 'badge-freemium' : 'badge-paid');
    node.querySelector('.result-category')!.textContent = listing.categoryLabel || listing.category;
    const dot = node.querySelector('.result-status-dot')!;
    dot.classList.add(listing.status?.up ? 'bg-brand-500' : 'bg-red-500');
    node.querySelector('.result-latency')!.textContent = `${listing.status?.avgLatencyMs ?? 0}ms`;
    return node;
  }

  function updateResults(query: string) {
    const resultsEl = document.getElementById('search-results')!;
    const statusEl = document.getElementById('search-status')!;
    resultsEl.innerHTML = '';

    if (!query.trim()) {
      statusEl.textContent = allListings.length ? `${allListings.length} tools indexed · start typing to search` : '';
      return;
    }

    if (!fuse) {
      statusEl.textContent = 'Loading…';
      return;
    }

    const matches = fuse.search(query, { limit: 24 });
    if (matches.length === 0) {
      statusEl.textContent = `No matches for "${query}". Try a different term.`;
      return;
    }

    statusEl.textContent = `${matches.length} result${matches.length === 1 ? '' : 's'} for "${query}"`;
    for (const m of matches) {
      resultsEl.appendChild(renderResult(m.item));
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadListings();
    const input = document.getElementById('search-input') as HTMLInputElement;
    let timer: any;
    input?.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => updateResults(input.value), 120);
    });
  });
</script>
